# ─────────────────────────────────────────────────────────────────────────────
# Bancada — variáveis de ambiente
#
# Este arquivo lista TODAS as variáveis que o sistema lê. Copie para `.env` e
# preencha. Nenhuma credencial de plataforma entra aqui: token de Mercado Livre,
# Shopee e Amazon mora cifrado na tabela `credencial` (ADR 0007). A única chave
# que vive em ambiente é a chave mestra de cifragem, abaixo.
# ─────────────────────────────────────────────────────────────────────────────

# Banco ──────────────────────────────────────────────────────────────────────
# Postgres 16+ com a extensão pgvector disponível (ADR 0006).
DATABASE_URL=postgres://bancada:bancada@localhost:5432/bancada

# Banco DESCARTÁVEL para a suíte de testes.
#
# Obrigatório para os testes de banco rodarem, e obrigatório que seja **outro**
# banco: a suíte faz `truncate` nas tabelas a cada teste. Apontar para o mesmo
# banco de `DATABASE_URL` apaga os seus dados — a suíte recusa e explica.
#
# Vazio é seguro: os testes de banco pulam e o resumo do vitest diz quantos.
#
# Em Postgres gerenciado, o caminho barato é uma **branch** do mesmo projeto (no
# Neon, `neon branches create teste`). Em Postgres local, um segundo banco:
#   createdb bancada_teste
DATABASE_URL_TESTE=

# Cifragem de credencial ─────────────────────────────────────────────────────
# 32 bytes em base64. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perder esta chave invalida todas as credenciais guardadas; elas precisam ser
# reautorizadas. Nunca versionar.
CREDENCIAL_CHAVE_MESTRA=

# Marca e identidade — nada disso é literal no código (seção 1.2 / ADR 0003) ──
# O nome abaixo é codinome de projeto, não marca. Trocar aqui troca no sistema.
BANCADA_NOME_SISTEMA=Bancada
BANCADA_CONSTRUTOR=Zirtuno
BANCADA_ANO_COPYRIGHT=2026
# Papel do sistema: interno | cliente | produto. Decide onde o nome do
# construtor aparece (seção 1.2). "interno" é o caso de hoje.
BANCADA_PAPEL=interno

# Perfil ativo ───────────────────────────────────────────────────────────────
# Slug do perfil de vendedor (linha em `perfil_vendedor`) usado quando não há
# seleção explícita. É dado, não código.
BANCADA_PERFIL_PADRAO=essencial-emporium

# LLM ────────────────────────────────────────────────────────────────────────
# Toda chamada é registrada em `llm_call` com custo e modelo (ADR 0005).
LLM_API_KEY=
LLM_MODELO_EXTRACAO=
LLM_MODELO_JULGAMENTO=
LLM_MODELO_EMBEDDING=
# Teto de gasto por execução de agente, em centavos. Agente sem teto não roda.
LLM_ORCAMENTO_PADRAO_CENTAVOS=500

# Extração ───────────────────────────────────────────────────────────────────
# Respeitar robots.txt e limite de requisição não é opcional (seção 10, item 7).
EXTRACAO_USER_AGENT=BancadaBot/0.1
EXTRACAO_RPS_MAX=1
EXTRACAO_CACHE_DIR=.cache/extracao

# Armazenamento de conteúdo ──────────────────────────────────────────────────
# Onde fica o original de tudo que entra, endereçado por hash sha256. Nunca se
# joga a entrada fora (ADR 0002); é daqui que o executor relê a planilha sem
# pedir o arquivo de novo. Diretório de dados, não de cache: não apagar.
ARMAZENAMENTO_DIR=.dados/conteudo

# Log ───────────────────────────────────────────────────────────────────────
# debug | info | aviso | erro. Padrão: info.
#
# Deliberadamente fora do schema de `src/config/ambiente.ts`: o registrador é
# usado por script que roda ANTES de o ambiente ser validado, e ambiente
# inválido precisa de log para ser diagnosticado. Ver src/infra/log.ts.
LOG_NIVEL=info
